bot.ready=EML-HeadlessBOT ready - 'help' lists commands, plain text sends chat, '/x' sends a server command
bot.bye=bye
bot.ask_username=username [{0}]: 
bot.stdin_closed=stdin closed: {0}
bot.unknown_command=unknown command: {0} (use 'help')
bot.connecting=connecting to {0}:{1} ...
bot.already_connected=already connected; use 'disconnect' first
bot.connect_failed=connect failed: {0}
bot.not_connected=not connected
bot.client_not_running=client is not running
bot.command_failed=command failed: {0}
bot.action_failed={0} failed: {1}
bot.no_plugins=no plugins loaded
bot.usage=usage: {0}
help.header=Commands:
help.footer=Plain text is sent as chat; leading '/' is sent as a server command.
cmd.help.desc=list all console commands
cmd.status.desc=show engine, connection and player state
cmd.botinfo.desc=show memory, CPU, disk usage, server connection and player info
cmd.connect.desc=open a multiplayer connection (username comes from --username)
cmd.disconnect.desc=close the current connection
cmd.say.desc=send chat to the server
cmd.cmd.desc=run a server command (without the leading slash)
cmd.slot.desc=select the hotbar slot
cmd.swing.desc=swing the held item
cmd.drop.desc=drop the held item, or the whole stack
cmd.attack.desc=start attacking the entity under the crosshair, or stop
cmd.look.desc=rotate the camera (drives raycasts and targeting)
cmd.mine.desc=start breaking the block at the given position
cmd.gamemode.desc=request a local game-mode change (server must allow it)
cmd.msgs.desc=print the tail of the received chat history
cmd.plugins.desc=list loaded plugins
cmd.quit.desc=stop the client and exit
cmd.slot.selected=hotbar slot -> {0}
cmd.drop.result=dropped={0}
cmd.attack.result=attacking={0}
cmd.gamemode.result=gamemode -> {0}
cmd.jfr.desc=start/stop a JFR profiling recording (.jfr file, open with JMC)
bot.jfr.started=JFR recording started; 'jfr stop' stops and writes the file (also dumped on exit)
bot.jfr.stopped=JFR recording written to: {0}
bot.jfr.start_failed=failed to start JFR recording; see log
bot.jfr.already_running=JFR recording already in progress; use 'jfr stop' first
bot.jfr.not_running=no JFR recording in progress
bot.jfr.unavailable=Flight Recorder is not available on this JVM (jdk.jfr module missing)
cmd.respawn.desc=respawn after death (manual, when autoRespawn is off in bot.yml)
bot.respawn.sent=respawn request sent
bot.respawn.not_dead=player is not dead
bot.died=died: {0} (use 'respawn' to respawn)
bot.died_auto=died: {0}, respawning automatically...
bot.pinging=pinging {0}:{1} to confirm the server is online...
bot.ping_ok={0}:{1} is online ({2} ms, {3}/{4} players, {5})
bot.ping_failed={0}:{1} did not answer a status ping: {2}
bot.dial_pending=already probing {0}:{1}; this attempt is ignored
