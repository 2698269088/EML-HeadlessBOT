# ---------- subcommand summaries ----------
summary.help=list every subcommand
summary.status=state, progress and switches
summary.start=start advertising on the configured schedule
summary.stop=stop advertising
summary.forcestop=stop and disable auto-start
summary.reload=re-read config.yml and restart the campaign
summary.list=list the messages
summary.add=append a message
summary.remove=delete by index or exact text
summary.set=replace the message at an index
summary.clear=empty the message list
summary.mode=switch between public and private
summary.interval=round interval for the active mode, in seconds
summary.publicinterval=round interval in public mode, in seconds
summary.privateinterval=round interval in private mode, in seconds
summary.gap=gap between two messages of one round, in seconds
summary.jitter=random spread on the round interval, in seconds
summary.gapjitter=random spread on the gap, in seconds
summary.random=send one random message per round
summary.skiprepeats=skip a line identical to the previous one
summary.suffix=append a short random suffix
summary.suffixlen=length of that suffix
summary.mathfont=render long digit runs as mathematical bold
summary.mathmin=minimum run length that gets styled
summary.greeting=greet players when they join
summary.greetingformat=greeting template; #name# #bot# #players# are substituted
summary.say=send one message publicly right now
summary.pm=send one message privately to a player right now
summary.players=list online and messageable players
summary.blacklist=manage the private-message blacklist
summary.burst=enable, disable or inspect the burst loop
summary.burstlist=list the burst messages
summary.burstadd=append a burst message
summary.burstremove=delete a burst message by index or text
summary.burstset=replace a burst message at an index
summary.sync=mirror the main list into the burst list
summary.burstinterval=delay between burst lines, in seconds
summary.burstduration=length of one burst window, in seconds
summary.lang=show the active language and entry count
