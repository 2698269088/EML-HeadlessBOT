<?xml version="1.0" encoding="UTF-8"?>
<!--
  EML-HeadlessBOT (ASM route)
  Own code only: javaagent patch engine + headless bot runtime.
  The Minecraft 26.1.2 client jar (mojmap) stays OUTSIDE this artifact:
    - compile time: against a locally generated access-opened copy (libs/minecraft-26.1.2-open.jar)
    - runtime:      the untouched jar, fetched into ./versions/ by the bot itself (eml.bootstrap)
  Both the build and the bot read ONLY files under this project directory: no launcher installation, no
  user home, no environment variable - so the same build works on any OS that runs Maven and a JDK.
  Nothing from Mojang is ever packaged into the output artifact, and libs/ is git-ignored.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.mcbot</groupId>
    <artifactId>EML-HeadlessBOT</artifactId>
    <version>1.0.0-26.1.2</version>
    <packaging>jar</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>

        <mc.version>26.1.2</mc.version>
        <asm.version>9.9</asm.version>
        <gson.version>2.13.2</gson.version>
        <netty.version>4.2.7.Final</netty.version>
        <log4j.version>2.25.2</log4j.version>

        <!--
          The client jar the compile-only opened copy is generated from, INSIDE this directory. The bot
          downloads it here on its first run (eml.bootstrap.MojangRuntime), so a fresh checkout needs
          nothing but one bot start - and no path outside the project is ever read.
        -->
        <mc.vanilla.jar>${project.basedir}/versions/${mc.version}/${mc.version}.jar</mc.vanilla.jar>
        <!--
          Derived dependency files (generated open jar + the ASM jars the generator needs) live in
          libs/, NOT in target/: `mvn clean` would delete them and then the compile classpath and the
          IntelliJ import are both broken until the generator happens to run again.
        -->
        <libs.dir>${project.basedir}/libs</libs.dir>
        <!--
          Compile-only view of the vanilla jar with relaxed access flags, produced during the initialize
          phase (before any dependency resolution) by OpenJarTool.
          Never packaged; the runtime always uses the untouched jar.
        -->
        <openjar.path>${libs.dir}/minecraft-${mc.version}-open.jar</openjar.path>
        <!--
          Executables of the JDK running Maven, WITHOUT an extension: Windows appends .exe when starting a
          process, so the same string works everywhere and no OS-specific property is needed. The classpath
          separator comes from the platform too (${path.separator} is ';' on Windows, ':' on Unix).
        -->
        <java.exe>${java.home}/bin/java</java.exe>
        <javac.exe>${java.home}/bin/javac</javac.exe>
        <!-- regenerate the compile-only opened jar even when it is up to date: -Dopenjar.force=true -->
        <openjar.force>false</openjar.force>
        <tool.classes>${project.build.directory}/openjar-tool</tool.classes>
        <tool.libs>${libs.dir}/tool</tool.libs>
    </properties>

    <repositories>
        <repository>
            <id>minecraft-repo</id>
            <url>https://libraries.minecraft.net/</url>
        </repository>
    </repositories>

    <dependencies>
        <!--
          Access-relaxed compile view of the user's own vanilla client jar (see openjar.path above):
          the donor templates in eml.template need to reference engine internals, which is legal at
          runtime only because the patch engine copies their bodies into the owning class.
          System scope is deliberate - the artifact is a local generated file, never published, and the
          shade step below excludes it from the jar.
        -->
        <dependency>
            <groupId>local.minecraft</groupId>
            <artifactId>minecraft-open</artifactId>
            <version>${mc.version}</version>
            <scope>system</scope>
            <systemPath>${openjar.path}</systemPath>
        </dependency>

        <!-- ===== patch engine (packaged) ===== -->
        <dependency><groupId>org.ow2.asm</groupId><artifactId>asm</artifactId><version>${asm.version}</version></dependency>
        <dependency><groupId>org.ow2.asm</groupId><artifactId>asm-tree</artifactId><version>${asm.version}</version></dependency>
        <dependency><groupId>org.ow2.asm</groupId><artifactId>asm-commons</artifactId><version>${asm.version}</version></dependency>

        <!-- ===== bot runtime libs (packaged) ===== -->
        <dependency><groupId>org.jline</groupId><artifactId>jline</artifactId><version>3.30.16</version></dependency>
        <dependency><groupId>org.fusesource.jansi</groupId><artifactId>jansi</artifactId><version>2.4.3</version></dependency>
        <dependency><groupId>org.yaml</groupId><artifactId>snakeyaml</artifactId><version>2.5</version></dependency>
        <dependency><groupId>com.google.code.gson</groupId><artifactId>gson</artifactId><version>2.13.2</version></dependency>

        <!-- ===== supplied by the launcher at runtime; compile/provided only ===== -->
        <dependency><groupId>com.mojang</groupId><artifactId>authlib</artifactId><version>7.0.63</version><scope>provided</scope></dependency>
        <dependency><groupId>com.mojang</groupId><artifactId>brigadier</artifactId><version>1.3.10</version><scope>provided</scope></dependency>
        <dependency><groupId>com.mojang</groupId><artifactId>datafixerupper</artifactId><version>9.0.19</version><scope>provided</scope></dependency>
        <dependency><groupId>com.mojang</groupId><artifactId>logging</artifactId><version>1.6.11</version><scope>provided</scope></dependency>
        <dependency><groupId>com.mojang</groupId><artifactId>blocklist</artifactId><version>1.0.10</version><scope>provided</scope></dependency>
        <dependency><groupId>io.netty</groupId><artifactId>netty-all</artifactId><version>${netty.version}</version><scope>provided</scope></dependency>
        <dependency><groupId>com.google.guava</groupId><artifactId>guava</artifactId><version>33.5.0-jre</version><scope>provided</scope></dependency>
        <dependency><groupId>it.unimi.dsi</groupId><artifactId>fastutil</artifactId><version>8.5.18</version><scope>provided</scope></dependency>
        <dependency><groupId>org.apache.commons</groupId><artifactId>commons-lang3</artifactId><version>3.19.0</version><scope>provided</scope></dependency>
        <dependency><groupId>org.apache.commons</groupId><artifactId>commons-compress</artifactId><version>1.28.0</version><scope>provided</scope></dependency>
        <dependency><groupId>commons-io</groupId><artifactId>commons-io</artifactId><version>2.20.0</version><scope>provided</scope></dependency>
        <dependency><groupId>commons-codec</groupId><artifactId>commons-codec</artifactId><version>1.19.0</version><scope>provided</scope></dependency>
        <dependency><groupId>net.sf.jopt-simple</groupId><artifactId>jopt-simple</artifactId><version>5.0.4</version><scope>provided</scope></dependency>
        <dependency><groupId>com.ibm.icu</groupId><artifactId>icu4j</artifactId><version>77.1</version><scope>provided</scope></dependency>
        <dependency><groupId>org.joml</groupId><artifactId>joml</artifactId><version>1.10.8</version><scope>provided</scope></dependency>
        <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId><version>2.0.17</version><scope>provided</scope></dependency>
        <dependency><groupId>org.apache.logging.log4j</groupId><artifactId>log4j-api</artifactId><version>${log4j.version}</version><scope>provided</scope></dependency>
        <dependency><groupId>org.apache.logging.log4j</groupId><artifactId>log4j-core</artifactId><version>${log4j.version}</version><scope>provided</scope></dependency>
        <dependency><groupId>org.apache.logging.log4j</groupId><artifactId>log4j-slf4j2-impl</artifactId><version>${log4j.version}</version><scope>provided</scope></dependency>
        <dependency><groupId>org.jspecify</groupId><artifactId>jspecify</artifactId><version>1.0.0</version><scope>provided</scope></dependency>
        <dependency><groupId>org.jetbrains</groupId><artifactId>annotations</artifactId><version>24.1.0</version><scope>provided</scope></dependency>
    </dependencies>

    <build>
        <sourceDirectory>src/main/java</sourceDirectory>
        <resources>
            <resource><directory>src/main/resources</directory><filtering>false</filtering></resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>25</release>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!--
              Pull ASM and Gson aside so the generator can be compiled before the project classpath exists:
              the generator needs Gson because it reuses the bot's own downloader (eml.bootstrap.MojangRuntime)
              to fetch a missing client jar.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>fetch-asm-for-generator</id>
                        <phase>initialize</phase>
                        <goals><goal>copy</goal></goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem><groupId>org.ow2.asm</groupId><artifactId>asm</artifactId><version>${asm.version}</version></artifactItem>
                                <artifactItem><groupId>org.ow2.asm</groupId><artifactId>asm-tree</artifactId><version>${asm.version}</version></artifactItem>
                                <artifactItem><groupId>com.google.code.gson</groupId><artifactId>gson</artifactId><version>${gson.version}</version></artifactItem>
                            </artifactItems>
                            <outputDirectory>${tool.libs}</outputDirectory>
                            <overWriteIfNewer>true</overWriteIfNewer>
                            <silent>true</silent>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
              initialize (before the compile classpath is ever resolved): compile the generator and run
              it, producing the access-relaxed jar that the system-scope dependency points at.
              Executables come from the JDK running Maven, so PATH does not matter.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.1</version>
                <executions>
                    <execution>
                        <id>compile-openjar-generator</id>
                        <phase>initialize</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>${javac.exe}</executable>
                            <arguments>
                                <argument>-nowarn</argument>
                                <argument>-encoding</argument><argument>UTF-8</argument>
                                <argument>-cp</argument><argument>${tool.libs}/asm-${asm.version}.jar${path.separator}${tool.libs}/asm-tree-${asm.version}.jar${path.separator}${tool.libs}/gson-${gson.version}.jar</argument>
                                <argument>-d</argument><argument>${tool.classes}</argument>
                                <argument>${project.basedir}/src/main/java/eml/engine/OpenJarTool.java</argument>
                                <argument>${project.basedir}/src/main/java/eml/bootstrap/MojangRuntime.java</argument>
                                <argument>${project.basedir}/src/main/java/eml/util/LaunchLog.java</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-open-jar</id>
                        <phase>initialize</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>${java.exe}</executable>
                            <arguments>
                                <argument>-cp</argument>
                                <argument>${tool.classes}${path.separator}${tool.libs}/asm-${asm.version}.jar${path.separator}${tool.libs}/asm-tree-${asm.version}.jar${path.separator}${tool.libs}/gson-${gson.version}.jar</argument>
                                <argument>eml.engine.OpenJarTool</argument>
                                <argument>${mc.vanilla.jar}</argument>
                                <argument>${openjar.path}</argument>
                                <argument>${project.basedir}</argument>
                                <argument>${mc.version}</argument>
                                <argument>${openjar.force}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- agent + runnable own-code jar; Mojang classes are physically excluded -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <!-- only our own classes + the runtime libs we bundle -->
                                <includes>
                                    <include>com.mcbot:EML-HeadlessBOT</include>
                                    <include>org.ow2.asm:*</include>
                                    <include>org.jline:jline</include>
                                    <include>org.fusesource.jansi:jansi</include>
                                    <include>org.yaml:snakeyaml</include>
                                    <include>com.google.code.gson:gson</include>
                                </includes>
                            </artifactSet>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>top.mcocet.hlbot.EML</mainClass>
                                    <manifestEntries>
                                        <Premain-Class>eml.agent.EmlAgent</Premain-Class>
                                        <Can-Retransform-Classes>false</Can-Retransform-Classes>
                                        <Can-Initialize-On-Entry>false</Can-Initialize-On-Entry>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/*.EC</exclude>
                                        <exclude>META-INF/SIG-*</exclude>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
